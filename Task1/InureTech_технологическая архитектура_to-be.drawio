                <mxCell id="lb-app-3" edge="1" parent="1" source="lb" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#202020;edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;endArrow=block;endFill=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=15;strokeColor=#333333;fontColor=#333333;exitX=0.5;exitY=1;entryX=1;entryY=0.3;exitPerimeter=1;entryPerimeter=1;" target="app-3" value="">

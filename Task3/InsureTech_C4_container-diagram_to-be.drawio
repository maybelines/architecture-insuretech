        <mxCell id="title" value="&lt;b style=&quot;font-size:28px&quot;&gt;InsureTech — C4: диаграмма контейнеров to-be&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;text;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2350" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Серые стрелки — синхронные запросы; синий пунктир — события." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;text;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="460" y="1630" width="1540" height="35" as="geometry" />
        </mxCell>
        <mxCell id="outbox-note" value="&lt;b&gt;Transactional Outbox&lt;/b&gt;&lt;br&gt;&lt;br&gt;core-app и ins-product-aggregator сохраняют данные и событие одной транзакцией. Фоновый обработчик отправляет события из outbox в Kafka.&lt;br&gt;&lt;br&gt;Получатель сохраняет event_id вместе с данными. Повторные события пропускаются." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;rounded=0;fillColor=#fff8df;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="1690" width="750" height="180" as="geometry" />
        </mxCell>
        <mxCell id="stream-note" value="&lt;b&gt;Обновление данных&lt;/b&gt;&lt;br&gt;&lt;br&gt;Агрегатор опрашивает компании раз в 15 минут. core-app и ins-comp-settlement используют разные группы потребителей и получают все изменения каталога.&lt;br&gt;&lt;br&gt;БД на схеме — отдельные схемы общего PostgreSQL." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=14;rounded=0;fillColor=#fff8df;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1250" y="1690" width="750" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>